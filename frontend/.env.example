# TachyonFi frontend config — copy to `.env` and fill in.
# Only VITE_-prefixed vars are exposed to the browser (Vite rule). NEVER put a
# private key here — the frontend signs nothing it doesn't get from the wallet.

# LitVM LiteForge testnet RPC (chain 4441).
VITE_RPC_URL=https://liteforge.rpc.caldera.xyz/infra-partner-http
VITE_CHAIN_ID=4441

# Deployed contract addresses (chain 4441). Match the root .env / latest deploy.
VITE_MUSD_ADDRESS=0x4aedab95d41a31f891ee12d13cd77102705e2def
VITE_LIQUIDITY_POOL_ADDRESS=0x4716a0c9c504f83918002a3086590f1ed192560b
VITE_POSITION_MANAGER_ADDRESS=0x9396d36f713302ff39e0ba5b38012656f8e4eacf

# Prediction-market factory (chain 4441) — the LIVE 8h factory, redeployed 2026-07-22.
# REQUIRED: there is NO fallback in code. `vite build` refuses to build without it and the
# prediction board throws on use, both naming this variable. That is deliberate — any
# hardcoded default is correct only until the next redeploy, and the superseded 24h factory
# 0x6338985C… is DRAINING: immutable and still answering calls, so a build pointed at it
# looks perfectly healthy while showing markets nobody trades. Loud beats silent here.
# Production reads this from the hosting project's env, not from this file.
VITE_PREDICTION_FACTORY_ADDRESS=0x7dd9e01fD4f96F9b1F875351eaccb5cA6C84c512

# RedStone pull-oracle data service (same as scripts/smoke-perps.mjs).
VITE_REDSTONE_DATA_SERVICE=redstone-primary-prod

# --- Quest verification API — SERVER-SIDE ONLY -----------------------------------
# Read by POST /api/quest/verify (a serverless function), never by the browser. Note the
# deliberate absence of a VITE_ prefix: Vite exposes only VITE_* to client code, so the
# naming is itself the guard. These duplicate some VITE_ addresses on purpose — the two
# sides are configured independently, and the function must not depend on client config.
#
# THE ADDRESSES HAVE NO DEFAULTS. A hardcoded address is correct only until the next
# redeploy, and a superseded contract stays immutable and keeps answering calls — quests
# would verify green against a contract nobody uses. Unset means the endpoint answers 503
# `not_configured`, never `completed: false`.
QUEST_POSITION_MANAGER_ADDRESS=0x9396D36F713302FF39E0bA5b38012656f8E4eACF
QUEST_LIQUIDITY_POOL_ADDRESS=0x4716a0c9c504F83918002A3086590f1ed192560B
QUEST_PREDICTION_FACTORY_ADDRESS=0x7dd9e01fD4f96F9b1F875351eaccb5cA6C84c512
# The superseded 24h factory. Still scanned: bets placed there before the 2026-07-22
# redeploy are real bets, and a user who made one must not be told they never bet.
QUEST_PREDICTION_FACTORY_OLD_ADDRESS=0x6338985C7f689C3e1959bfe1a8bb36E44849EA40

# Scan floors — the block each contract was deployed in, where a backward log scan stops.
# Defaults are compiled in (see api/_lib/quest/chain.js) and were RECOVERED by eth_getCode
# binary search on 2026-07-25, because no deploy record contains them.
#
# A FLOOR IS COUPLED TO ITS ADDRESS. Change an address above without changing its floor and
# the scan walks the wrong range: too low merely wastes time, but TOO HIGH would skip the
# events it is looking for. The scanner validates a floor before reporting any negative, so
# the failure is a loud indeterminate rather than a wrong answer — but fix the pair.
# QUEST_POSITION_MANAGER_DEPLOY_BLOCK=23302630
# QUEST_LIQUIDITY_POOL_DEPLOY_BLOCK=23302630
# QUEST_PREDICTION_FACTORY_DEPLOY_BLOCK=32222320
# QUEST_PREDICTION_FACTORY_OLD_DEPLOY_BLOCK=30665562

# Optional. Defaults are fine.
# QUEST_RPC_URL=          # defaults to the public LiteForge endpoint (see src/config.js)
# QUEST_CHAIN_ID=4441
# QUEST_RPM=10            # per-IP rate limit; tighter than Tachy's because a Tier 2 scan
# QUEST_RPH=100           # can spend ~15s of RPC budget
# QUEST_CACHE=memory      # "memory" (default), "supabase", or "none". Safe to disable: the
#                         # cache only ever stores PROVEN completions, so "none" costs
#                         # latency only. "supabase" needs the two vars below; if either is
#                         # missing it logs an error and falls back to "memory" rather than
#                         # failing requests — you lose durability, never correctness.
# QUEST_CURSOR=           # driver for the SCAN-COVERAGE cursor. Defaults to whatever
#                         # QUEST_CACHE is set to, since in practice they share a project
#                         # and a key. Same three values. This is a SEPARATE store from the
#                         # cache above: that one holds proven completions, this one holds
#                         # which block ranges have been walked, and the verdict is derived
#                         # from coverage on every read rather than stored. Setting "none"
#                         # is the kill switch — every poll then restarts from head, so a
#                         # deep-history wallet stays indeterminate forever. Slower and
#                         # less useful, never wrong.

# --- Quest cache, phase 2 (Supabase) — SERVER-SIDE ONLY ---------------------------
# WIRED for the verification cache (QUEST_CACHE=supabase). The memory driver only survives
# within one warm lambda instance, which is why durable storage is needed for:
#   1. proven completions surviving cold starts and redeploys           <- DONE
#   2. deep history, via a resumable cursor (scanned_from/scanned_to per wallet+SOURCE) so
#      repeated verifications converge instead of restarting from head  <- DONE, this step
#   3. `daily_active`, which cannot be a live scan at all (~104s of getLogs against a 30s
#      limit) and needs a forward indexer for an O(1) "active today"    <- step 4
#
# Apply supabase/migrations/*.sql by hand before switching QUEST_CACHE to "supabase" —
# nothing in CI applies them, and an unmigrated project just makes every read a miss.
#
# THE SERVICE-ROLE KEY BYPASSES ROW-LEVEL SECURITY. It must NEVER be VITE_-prefixed and
# must never appear in client code — a prefix would inline it into the browser bundle and
# hand every visitor full table access. Two tests enforce this (test/quest/env.test.js):
# no SUPABASE_* may carry the prefix, and src/ may not mention SUPABASE_ at all. Do not
# weaken either.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# --- Tachy (AI assistant) — SERVER-SIDE ONLY -------------------------------------
# These are read by the serverless function in `api/`, never by the browser. Note the
# deliberate absence of a VITE_ prefix: Vite only exposes VITE_* to client code, so the
# naming itself is what stops a key being bundled. Do NOT rename these with a prefix.
#
# In production these live in the Vercel project's Environment Variables, not here.
# Locally, put the keys in `.env` (gitignored) and run `npm run dev:api`
# (`vercel dev`) — plain `vite dev` does not serve /api at all. `npm run dev:tachy`
# runs the endpoint alone on a bare Node server, which is what the smoke test needs.

# Which model backend serves this deploy: "groq" (default) or "gemini".
# Only the selected provider's key is required. An unrecognised value logs an error and
# falls back to the default rather than failing requests.
#
# Groq is the soft-launch default because of CONCURRENCY, not answer quality: both
# providers hold every safety rail with equally clean JSON (37/37 live samples, 0%
# malformed — `npm run tachy:audit`). The difference is that Gemini's free tier is 5
# requests/minute GLOBAL, so two users chatting at once both get fallbacks and the app
# reads as broken. Groq absorbs that. Switching back is this one variable.
TACHY_PROVIDER=groq

# Required when TACHY_PROVIDER=groq. Get one from https://console.groq.com/keys
GROQ_API_KEY=

# Required when TACHY_PROVIDER=gemini. Get one from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Local dev only: where the browser's /api calls actually go -------------------
# Read by vite.config.js, NOT by the serverless function. It has no effect on a
# deployed build — in production the browser and /api/tachy are the same origin.
#
# `vite dev` serves the SPA and has no notion of `api/`, so a POST to /api/tachy would
# fall through to the index.html rewrite and hand the client a 200 full of HTML. The
# dev proxy is therefore mandatory, and this is its target.
#
# DEFAULT (leave this commented): http://localhost:3000 — run `npm run dev:tachy` in a
# second terminal and iterate on the UI without spending the production quota. Use
# `TACHY_PROVIDER=groq npm run dev:tachy` so local matches what prod serves; without it
# the harness defaults to Gemini, whose free tier is 5 req/min GLOBAL.
#
# To test the UI against the LIVE endpoint, either uncomment the line below or prefix
# the command:
#   TACHY_API_ORIGIN=https://app.tachyonfi.xyz npm run dev
# Every message then costs real free-tier quota (~65/day), which is why this is opt-in
# rather than the default. A shell prefix wins over the value in .env.
# TACHY_API_ORIGIN=https://app.tachyonfi.xyz

# ================================================================================
# QUOTA — READ BEFORE LAUNCH.
#
# NEITHER FREE TIER IS SUFFICIENT FOR REAL TRAFFIC. A paid tier is a PRE-SCALE
# REQUIREMENT, not an optimisation — same call as the Railway decision. What follows is
# a demo allowance, and the ceilings below are the ones that break first.
#
# GROQ free tier, llama-3.3-70b-versatile (docs table + this key's live x-ratelimit-*
# headers, 2026-07-25):
#     RPM 30 | RPD 1,000 | TPM 12,000 | TPD 100,000
#   RPM IS NOT THE BINDING LIMIT. A Tachy call costs ~1,430 prompt tokens (the system
#   instruction is long) plus ~60-250 completion, so the 12,000 TPM budget runs out at
#   roughly 7-8 requests/minute — well short of 30. TACHY_RPM therefore defaults to 7.
#   THE HARD CEILING IS TPD 100,000 = about 65 EXCHANGES PER DAY, key-global. That is a
#   demo allowance. It is exhausted by a single engaged user in one sitting, and no
#   per-IP limiter can enforce a key-global cap.
#
# GEMINI free tier, gemini-3.6-flash: 5 generate_content requests/minute (measured
#   2026-07-25), also a GLOBAL cap on the key while our limiter is per-IP. Realistically
#   serves about one person at a time. TACHY_RPM defaults to 4.
#
# Both limiters sit UNDER their upstream quota deliberately: a limiter set above it just
# forwards the overflow and burns quota collecting 429s. Defaults are per-provider (see
# api/_lib/providers/*.js); set TACHY_RPM only to override them deliberately.
# ================================================================================

# Optional overrides — defaults in api/_lib/config.js are fine for normal use.
# TACHY_MODEL=                   # per-provider default; see below
#   groq   -> llama-3.3-70b-versatile     DEFAULT. Largest Llama on the free tier (the
#                                         account has no Llama 4 tier). Uses json_object:
#                                         valid JSON guaranteed, schema NOT enforced by
#                                         the decoder, so the shape is stated in the
#                                         prompt instead. Measured 0% malformed.
#   groq   -> openai/gpt-oss-120b         EVEN STRICTER JSON. The only Groq family that
#                                         supports real schema-constrained decoding
#                                         (response_format json_schema, strict:true) —
#                                         every Llama model rejects json_schema with a
#                                         400. The driver detects this and upgrades
#                                         automatically, so this is an env-only switch.
#                                         Use it if schema drift ever shows up in
#                                         production telemetry as invalid_response.
#                                         Note its own tighter budget: TPM 8,000.
#   gemini -> gemini-3.6-flash            pinned stable Flash id; avoid the -latest alias
# TACHY_RPM=                     # requests per minute, per IP — keep under the tier cap
# TACHY_RPH=                     # requests per hour, per IP
# TACHY_MAX_CHARS=1000           # max characters in a single user message
# TACHY_MAX_TURNS=8              # max conversation turns sent upstream
# TACHY_MAX_OUTPUT_TOKENS=1200   # shared with thinking/reasoning tokens — needs headroom
# TACHY_TIMEOUT_MS=8500          # must stay under vercel.json maxDuration (10s)

# quest-indexer — SERVER-SIDE ONLY, and deliberately a very short list.
#
# This is a THIRD Railway service, independent of the perp keeper and the prediction
# keeper. It exists as its own process so that a crash, hang or OOM here cannot touch the
# live money-path services. It is READ-ONLY on chain and writes only to Supabase.
#
# IT MUST NEVER BE GIVEN A PRIVATE KEY. There is no signer in this service and no reason
# for one — it reads logs and writes rows. test/isolation.test.mjs enforces both halves of
# that: the shipped code contains no signer construction, and the full set of env vars read
# anywhere in the service is asserted against the allow-list below. Adding a variable means
# updating that test, which is the point.

# --- Supabase (same project and key as the Vercel functions) ---------------------
# The service-role key bypasses row-level security. Server-side only; it never goes near a
# browser bundle, and unlike the frontend there is no VITE_ prefix hazard here because
# nothing in this service is bundled for a client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Chain (the SAME names the Vercel read path uses) ----------------------------
# Deliberately identical variable names to frontend/.env.example. The indexer WRITES
# quest_daily and the read path REQUIRES those same sources to be fresh before it will read
# it; if the two ever pointed at different contracts, a wallet whose only activity was on
# the odd source out would get a confident `completed: false`. Sharing the names is how
# configuration stays in step through the environment rather than through code — a redeploy
# is one env change on both sides.
#
# NO DEFAULTS for the addresses, by design. A superseded contract stays immutable and keeps
# answering calls, so a stale address would let this service index a contract nobody uses,
# report itself perfectly fresh, and hand out confident falses. Missing config kills the
# process on startup instead.
QUEST_POSITION_MANAGER_ADDRESS=
QUEST_LIQUIDITY_POOL_ADDRESS=
QUEST_PREDICTION_FACTORY_ADDRESS=
QUEST_PREDICTION_FACTORY_OLD_ADDRESS=

# Optional. Defaults are fine.
# QUEST_RPC_URL=          # defaults to the public LiteForge endpoint
# QUEST_CHAIN_ID=4441
# QUEST_INDEXER_CONFIRMATIONS=20
#                         # Blocks to trail head by. quest_daily has no delete path, so a
#                         # row written for a block that later reorgs away is a permanent
#                         # false POSITIVE. Trailing costs one cron period of latency on a
#                         # quest measured in days. Must stay well below the read path's
#                         # QUEST_INDEXER_MAX_LAG_MS threshold or the index reads stale.
# QUEST_INDEXER_INTERVAL_MS=60000
#                         # Tick period. Well inside the read path's 15-minute freshness
#                         # threshold, so ~15 consecutive missed ticks are survivable before
#                         # daily_active degrades to indeterminate.
# QUEST_INDEXER_MAX_RANGE=5000
#                         # Per-source, per-run block cap. Without it, a long outage creates
#                         # a catch-up range too big to finish inside one run — so the run
#                         # never commits, the watermark never moves, and the index is stuck
#                         # stale forever rather than recovering. With it, catch-up happens
#                         # across many runs at roughly 5x realtime.
